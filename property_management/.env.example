# Copy to .env for local dev, or set these in DigitalOcean App Platform > Settings > Environment.
# NEVER commit a real .env. Values below are placeholders.

# ── Core ─────────────────────────────────────────────────────────────────────
ENV=production
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=home-sweet-home-management-cfbfz.ondigitalocean.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://home-sweet-home-management-cfbfz.ondigitalocean.app

# ── Database (DigitalOcean managed Postgres) ─────────────────────────────────
DATABASE_URL=postgres://user:password@host:25060/dbname

# ── Email (Gmail SMTP — use an App Password, not the account password) ────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=homesweethome.pmanagement@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=homesweethome.pmanagement@gmail.com

# ── Xero ─────────────────────────────────────────────────────────────────────
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
XERO_REDIRECT_URI=https://home-sweet-home-management-cfbfz.ondigitalocean.app/finance/xero/callback
# XERO_SCOPES=openid profile email accounting.transactions accounting.contacts offline_access

# ── Initial admin (used by create_admin.py; do not keep weak values) ─────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=you@example.com
DJANGO_SUPERUSER_PASSWORD=use-a-strong-unique-password

# ── Optional: DigitalOcean Spaces (file storage). Leave USE_S3=0 to skip. ─────
USE_S3=0
# DO_SPACES_KEY=
# DO_SPACES_SECRET=
# AWS_STORAGE_BUCKET_NAME=
# DO_SPACES_REGION=lon1
# DO_SPACES_ENDPOINT=https://lon1.digitaloceanspaces.com
